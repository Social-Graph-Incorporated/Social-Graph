{
    "compilerOptions": {
        "jsx": "react",
        "target": "ES6",
        "module": "commonjs",
        "lib": ["ES2017", "DOM"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": ["src"]
}